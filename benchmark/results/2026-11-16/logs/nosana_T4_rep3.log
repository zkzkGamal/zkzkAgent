 }\n        .eq {\n            background: #4caf50;\n            color: #fff;\n        }\n        .eq:hover {\n            background: #43a047;\n        }\n        .clear {\n            background: #ef5350;\n            color: #fff;\n        }\n        .clear:hover {\n            background: #e53935;\n        }\n        .span-2 {\n            grid-column: span 2;\n        }\n        .error {\n            color: #d32f2f;\n            font-size: 14px;\n            min-height: 20px;\n            margin-top: 8px;\n            text-align: center;\n        }\n    </style>\n</head>\n<body>\n    <div class="calculator">\n        <input class="display" id="display" type="text" autocomplete="off" spellcheck="false">\n        <div class="buttons">\n            <button class="clear" data-action="clear">C</button>\n            <button data-action="backspace">⌫</button>\n            <button data-action="paren" data-value="(">(</button>\n            <button data-action="paren" data-value=")">)</button>\n            <button data-value="7">7</button>\n            <button data-value="8">8</button>\n            <button data-value="9">9</button>\n            <button class="op" data-value="/">/</button>\n            <button data-value="4">4</button>\n            <button data-value="5">5</button>\n            <button data-value="6">6</button>\n            <button class="op" data-value="*">*</button>\n            <button data-value="1">1</button>\n            <button data-value="2">2</button>\n            <button data-value="3">3</button>\n            <button class="op" data-value="-">-</button>\n            <button data-value="0">0</button>\n            <button data-value=".">.</button>\n            <button class="op" data-value="+">+</button>\n            <button class="op" data-value="**">**</button>\n            <button class="eq span-2" data-action="equals">=</button>\n        </div>\n        <div class="error" id="error"></div>\n    </div>\n\n    <script>\n        const display = document.getElementById("display");\n        const errorEl = document.getElementById("error");\n\n        function appendValue(value) {\n            errorEl.textContent = "";\n            display.value += value;\n        }\n\n        async function calculate() {\n            const expression = display.value.trim();\n            if (!expression) return;\n            try {\n                const response = await fetch("/api/calculate", {\n                    method: "POST",\n                    headers: { "Content-Type": "application/json" },\n                    body: JSON.stringify({ expression: expression }),\n                });\n                const data = await response.json();\n                if (!response.ok) {\n                    throw new Error(data.detail || "Error");\n                }\n                display.value = data.result;\n                errorEl.textContent = "";\n            } catch (err) {\n                errorEl.textContent = err.message;\n            }\n        }\n\n        document.querySelectorAll("button").forEach((button) => {\n            button.addEventListener("click", () => {\n                const action = button.dataset.action;\n                const value = button.dataset.value;\n                if (action === "clear") {\n                    display.value = "";\n                    errorEl.textContent = "";\n                } else if (action === "backspace") {\n                    display.value = display.value.slice(0, -1);\n                    errorEl.textContent = "";\n                } else if (action === "equals") {\n                    calculate();\n                } else if (value) {\n                    appendValue(value);\n                }\n            });\n        });\n\n        display.addEventListener("keydown", (event) => {\n            if (event.key === "Enter") {\n                calculate();\n            }\n        });\n    </script>\n</body>\n</html>\n'}, 'id': 'chatcmpl-tool-868159b8a43acbcc', 'type': 'tool_call'}]
                
