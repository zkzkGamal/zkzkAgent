<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Calculator</title>
  <style>
    body {
      font-family: system-ui, sans-serif;
      background: #f3f4f6;
      display: grid;
      place-items: center;
      min-height: 100vh;
      margin: 0;
    }

    main {
      background: #111827;
      color: #fff;
      padding: 1rem;
      border-radius: 1rem;
      width: min(92vw, 360px);
    }

    h1 {
      font-size: 1.1rem;
      margin: 0 0 .75rem;
      text-align: center;
    }

    #display {
      width: 100%;
      box-sizing: border-box;
      font-size: 1.4rem;
      padding: .75rem;
      border-radius: .5rem;
      border: 0;
      background: #1f2937;
      color: #f9fafb;
      text-align: right;
      margin-bottom: .75rem;
      overflow-wrap: anywhere;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: .5rem;
    }

    button {
      font-size: 1.2rem;
      padding: .85rem 0;
      border: 0;
      border-radius: .5rem;
      background: #374151;
      color: #fff;
      cursor: pointer;
    }

    button:hover {
      background: #4b5563;
    }

    button.operator {
      background: #4f46e5;
    }

    button.equals {
      background: #16a34a;
    }

    button.danger {
      background: #dc2626;
    }
  </style>
</head>
<body>
  <main>
    <h1>Calculator</h1>
    <input id="display" value="0" readonly />

    <div class="grid">
      <button class="danger" data-key="C">C</button>
      <button data-key="backspace">⌫</button>
      <button class="operator" data-key="/">/</button>
      <button class="operator" data-key="**">^</button>

      <button data-key="7">7</button>
      <button data-key="8">8</button>
      <button data-key="9">9</button>
      <button class="operator" data-key="*">*</button>

      <button data-key="4">4</button>
      <button data-key="5">5</button>
      <button data-key="6">6</button>
      <button class="operator" data-key="-">-</button>

      <button data-key="1">1</button>
      <button data-key="2">2</button>
      <button data-key="3">3</button>
      <button class="operator" data-key="+">+</button>

      <button data-key="0">0</button>
      <button data-key=".">.</button>
      <button class="equals" data-key="=">=</button>
      <button class="operator" data-key="%">%</button>
    </div>
  </main>

  <script>
    const display = document.getElementById("display");
    let expression = "";

    function updateDisplay() {
      display.value = expression || "0";
    }

    async function evaluate() {
      const trimmed = expression.trim();
      if (!trimmed) return;

      try {
        const response = await fetch("/api/calculate", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            expression: trimmed
          })
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.detail || "Calculation failed");
        }

        expression = String(data.result);
      } catch (error) {
        expression = "Error";
      }

      updateDisplay();
    }

    function handleKey(key) {
      if (key === "C") {
        expression = "";
      } else if (key === "backspace") {
        expression = expression.slice(0, -1);
      } else if (key === "=") {
        void evaluate();
        return;
      } else {
        if (expression === "Error") {
          expression = "";
        }

        expression += key;
      }

      updateDisplay();
    }

    document.querySelectorAll("button[data-key]").forEach((button) => {
      button.addEventListener("click", () => {
        handleKey(button.dataset.key);
      });
    });

    document.addEventListener("keydown", (event) => {
      const key = event.key;

      if (/^[0-9+\-*/%.()]+$/.test(key)) {
        handleKey(key);
      } else if (key === "Enter") {
        event.preventDefault();
        handleKey("=");
      } else if (key === "Backspace") {
        handleKey("backspace");
      } else if (key.toLowerCase() === "c") {
        handleKey("C");
      }
    });
  </script>
</body>
</html>
```

