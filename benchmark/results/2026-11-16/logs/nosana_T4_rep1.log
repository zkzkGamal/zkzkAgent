   ```python
   from pathlib import Path
   import ast
   import operator
   from typing import Union

   from fastapi import FastAPI, HTTPException
   from fastapi.staticfiles import StaticFiles
   from fastapi.responses import FileResponse
   from pydantic import BaseModel

   BASE_DIR = Path(__file__).resolve().parent

   app = FastAPI(title="calc_app")
   app.mount("/static", StaticFiles(directory=BASE_DIR / "static"), name="static")

   class CalculateRequest(BaseModel):
       expression: str

   BIN_OPS = {
       ast.Add: operator.add,
       ast.Sub: operator.sub,
       ast.Mult: operator.mul,
       ast.Div: operator.truediv,
       ast.Mod: operator.mod,
       ast.Pow: operator.pow,
   }

   UNARY_OPS = {
       ast.UAdd: operator.pos,
       ast.USub: operator.neg,
   }

   def evaluate(node: ast.AST) -> Union[int, float]:
       if isinstance(node, ast.Expression):
           return evaluate(node.body)

       if isinstance(node, ast.Constant):
           if isinstance(node.value, (int, float)):
               return node.value
           raise ValueError("Only numeric constants are allowed")

       if isinstance(node, ast.BinOp):
           op = type(node.op)
           if op not in BIN_OPS:
               raise ValueError("Unsupported operator")
           return BIN_OPS[op](evaluate(node.left), evaluate(node.right))

       if isinstance(node, ast.UnaryOp):
           op = type(node.op)
           if op not in UNARY_OPS:
               raise ValueError("Unsupported unary operator")
           return UNARY_OPS[op](evaluate(node.operand))

       raise ValueError("Unsupported expression")

   @app.get("/")
   async def index() -> FileResponse:
       return FileResponse(BASE_DIR / "static" / "index.html")

   @app.post("/api/calculate")
   async def calculate(payload: CalculateRequest) -> dict:
       try:
           result = evaluate(ast.parse(payload.expression, mode="eval").body)
           if isinstance(result, float) and result.is_integer():
               result = int(result)
           return {"result": result}
       except ZeroDivisionError:
           raise HTTPException(status_code=400, detail="Division by zero")
       except Exception:
           raise HTTPException(status_code=400, detail="Invalid expression")
   ```

3. **Write frontend page**: Use `write_file` with `working_directory=/home/aloha-zkaria/zkzk-bench/nosana/T4/rep1/calc_app`, `file_path=/home/aloha-zkaria/zkzk-bench/nosana/T4/rep1/calc_app/static/index.html`, and the following content. This should create the `static` directory if needed:
   ```html
   <!doctype html>
   <html lang="en">
   <head>
     <meta charset="utf-8">
     <meta name="viewport" content="width=device-width, initial-scale=1">
     <title>Calculator</title>
     <style>
       body {
         font-family: system-ui, sans-serif;
         max-width: 420px;
         margin: 2rem auto;
       }
       input {
         width: 100%;
         padding: 0.5rem;
         font-size: 1rem;
         box-sizing: border-box;
       }
       button {
         margin-top: 0.5rem;
         padding: 0.5rem 1rem;
       }
       #result {
         margin-top: 1rem;
         font-size: 1.25rem;
         min-height: 1.5rem;
       }
       .error {
         color: #b00020;
       }
     </style>
   </head>
   <body>
     <h1>Calculator</h1>
     <form id="calc-form">
       <input
         id="expression"
         name="expression"
         type="text"
         placeholder="Example: (1 + 2) * 3"
         autocomplete="off"
         required
       >
       <button type="submit">Calculate</button>
     </form>
     <p id="result" aria-live="polite"></p>
     <script>
       const form = document.getElementById('calc-form');
       const expressionInput = document.getElementById('expression');
       const resultEl = document.getElementById('result');

       form.addEventListener('submit', async (event) => {
         event.preventDefault();
         const expression = expressionInput.value.trim();
         if (!expression) return;

         resultEl.classList.remove('error');
         resultEl.textContent = 'Calculating…';

         try {
           const response = await fetch('/api/calculate', {
             method: 'POST',
             headers: {
               'Content-Type': 'application/json'
             },
             body: JSON.stringify({ expression })
           });

           const data = await response.json();
           if (!response.ok) {
             throw new Error(data.detail || 'Calculation failed');
           }

           resultEl.textContent = String(data.result);
         } catch (error) {
           resultEl.classList.add('error');
           resultEl.textContent = error.message;
         }
       });
     </script>
   </body>
   </html>
   ```

