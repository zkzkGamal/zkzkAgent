   ```python
   import ast
   import operator
   import pathlib

   from fastapi import FastAPI, HTTPException
   from fastapi.responses import FileResponse
   from fastapi.staticfiles import StaticFiles
   from pydantic import BaseModel

   BASE_DIR = pathlib.Path(__file__).resolve().parent
   STATIC_DIR = BASE_DIR / "static"

   app = FastAPI(title="Calc App")

   app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")


   class CalculateRequest(BaseModel):
       expression: str


   OPERATORS = {
       ast.Add: operator.add,
       ast.Sub: operator.sub,
       ast.Mult: operator.mul,
       ast.Div: operator.truediv,
       ast.Pow: operator.pow,
       ast.Mod: operator.mod,
       ast.USub: operator.neg,
       ast.UAdd: operator.pos,
   }


   def evaluate_node(node: ast.AST):
       if isinstance(node, ast.Expression):
           return evaluate_node(node.body)

       if isinstance(node, ast.Constant):
           if isinstance(node.value, bool):
               raise HTTPException(status_code=400, detail="Unsupported constant")
           if isinstance(node.value, (int, float)):
               return node.value
           raise HTTPException(status_code=400, detail="Unsupported constant")

       if isinstance(node, ast.BinOp):
           op = OPERATORS.get(type(node.op))
           if op is None:
               raise HTTPException(status_code=400, detail="Unsupported operator")
           left = evaluate_node(node.left)
           right = evaluate_node(node.right)
           return op(left, right)

       if isinstance(node, ast.UnaryOp):
           op = OPERATORS.get(type(node.op))
           if op is None:
               raise HTTPException(status_code=400, detail="Unsupported operator")
           return op(evaluate_node(node.operand))

       raise HTTPException(status_code=400, detail="Unsupported expression")


   @app.get("/")
   def serve_index():
       return FileResponse(STATIC_DIR / "index.html")


   @app.post("/api/calculate")
   def calculate(request: CalculateRequest):
       try:
           tree = ast.parse(request.expression, mode="eval")
       except SyntaxError:
           raise HTTPException(status_code=400, detail="Invalid expression")

       try:
           result = evaluate_node(tree)
       except ZeroDivisionError:
           raise HTTPException(status_code=400, detail="Division by zero")
       except HTTPException:
           raise

       return {"result": result}
   ```

4. **Write static frontend file**  
   Use `write_file` with:  
   - `working_directory=/home/aloha-zkaria/zkzk-bench/hybrid/T4/rep1/calc_app/static`  
   - `file_path=index.html`  
   - `content=`:
   ```html
   <!DOCTYPE html>
   <html lang="en">
   <head>
       <meta charset="UTF-8">
       <meta name="viewport" content="width=device-width, initial-scale=1.0">
       <title>Calculator</title>
       <style>
           body {
               font-family: Arial, sans-serif;
               max-width: 520px;
               margin: 40px auto;
               padding: 16px;
           }

           h1 {
               margin-bottom: 20px;
           }

           form {
               display: flex;
               flex-direction: column;
           }

           input {
               padding: 10px;
               font-size: 16px;
               border: 1px solid #ccc;
               border-radius: 4px;
               margin-bottom: 12px;
           }

           button {
               padding: 10px;
               font-size: 16px;
               border: none;
               border-radius: 4px;
               background: #0066cc;
               color: white;
               cursor: pointer;
           }

           button:hover {
               background: #0052a3;
           }

           #result {
               margin-top: 20px;
               font-size: 18px;
               min-height: 24px;
           }
       </style>
   </head>
   <body>
       <h1>Calculator</h1>

       <form id="calc-form">
           <input id="expression" type="text" placeholder="Example: 2 + 2" required>
           <button type="submit">Calculate</button>
       </form>

       <div id="result"></div>

       <script>
           document.getElementById("calc-form").addEventListener("submit", async (event) => {
               event.preventDefault();

               const expression = document.getElementById("expression").value.trim();
               const resultDiv = document.getElementById("result");
               resultDiv.textContent = "";

               try {
                   const response = await fetch("/api/calculate", {
                       method: "POST",
                       headers: {
                           "Content-Type": "application/json",
                       },
                       body: JSON.stringify({ expression }),
                   });

                   const data = await response.json();

                   if (!response.ok) {
                       throw new Error(data.detail || "Unknown error");
                   }

                   resultDiv.textContent = String(data.result);
               } catch (error) {
                   resultDiv.textContent = "Error: " + error.message;
               }
           });
       </script>
   </body>
   </html>
   ```

