from pathlib import Path

import ast
import operator

from fastapi import FastAPI, HTTPException
from fastapi.responses import FileResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel

BASE_DIR = Path(__file__).resolve().parent
STATIC_DIR = BASE_DIR / "static"

app = FastAPI(title="Calc App")

if STATIC_DIR.exists():
    app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")


class CalculateRequest(BaseModel):
    expression: str


SUPPORTED_OPERATORS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.FloorDiv: operator.floordiv,
    ast.Mod: operator.mod,
    ast.Pow: operator.pow,
    ast.USub: operator.neg,
    ast.UAdd: operator.pos,
}


def _evaluate(node: ast.AST):
    if isinstance(node, ast.Expression):
        return _evaluate(node.body)

    if isinstance(node, ast.Constant):
        if isinstance(node.value, bool) or not isinstance(node.value, (int, float)):
            raise HTTPException(
                status_code=400,
                detail="Only numeric constants are supported"
            )
        return node.value

    if isinstance(node, ast.BinOp):
        op_type = type(node.op)
        if op_type not in SUPPORTED_OPERATORS:
            raise HTTPException(
                status_code=400,
                detail="Unsupported operator"
            )
        return SUPPORTED_OPERATORS[op_type](_evaluate(node.left), _evaluate(node.right))

    if isinstance(node, ast.UnaryOp):
        op_type = type(node.op)
        if op_type not in SUPPORTED_OPERATORS:
            raise HTTPException(
                status_code=400,
                detail="Unsupported unary operator"
            )
        return SUPPORTED_OPERATORS[op_type](_evaluate(node.operand))

    raise HTTPException(
        status_code=400,
        detail="Unsupported expression"
    )


@app.get("/", include_in_schema=False)
async def serve_index():
    return FileResponse(STATIC_DIR / "index.html")


@app.post("/api/calculate")
async def calculate(request: CalculateRequest):
    expression = request.expression.strip()

    if not expression:
        raise HTTPException(
            status_code=400,
            detail="Expression must not be empty"
        )

    try:
        tree = ast.parse(expression, mode="eval")
    except SyntaxError as exc:
        raise HTTPException(
            status_code=400,
            detail=f"Invalid expression syntax: {exc}"
        )

    try:
        result = _evaluate(tree)
    except ZeroDivisionError:
        raise HTTPException(
            status_code=400,
            detail="Division by zero"
        )
    except HTTPException:
        raise
    except Exception:
        raise HTTPException(
            status_code=400,
            detail="Could not evaluate expression"
        )

    if isinstance(result, float) and result.is_integer():
        result = int(result)

    return {"result": result}
```

