     ```python
     import ast
     import operator
     from pathlib import Path

     from fastapi import FastAPI, HTTPException
     from fastapi.responses import FileResponse
     from pydantic import BaseModel

     BASE_DIR = Path(__file__).resolve().parent
     INDEX_PATH = BASE_DIR / "static" / "index.html"

     app = FastAPI(title="Calculator Web App")


     class CalculateRequest(BaseModel):
         expression: str


     ALLOWED_BINOPS = {
         ast.Add: operator.add,
         ast.Sub: operator.sub,
         ast.Mult: operator.mul,
         ast.Div: operator.truediv,
         ast.FloorDiv: operator.floordiv,
         ast.Mod: operator.mod,
         ast.Pow: operator.pow,
     }

     ALLOWED_UNARY = {
         ast.UAdd: operator.pos,
         ast.USub: operator.neg,
     }


     def _validate(node: ast.AST) -> None:
         if isinstance(node, ast.Expression):
             _validate(node.body)
             return

         if isinstance(node, ast.Constant):
             if isinstance(node.value, bool) or not isinstance(node.value, (int, float)):
                 raise HTTPException(status_code=400, detail="Only numeric values are allowed")
             return

         if isinstance(node, ast.BinOp):
             _validate(node.left)
             if type(node.op) not in ALLOWED_BINOPS:
                 raise HTTPException(
                     status_code=400,
                     detail=f"Unsupported operator: {type(node.op).__name__}",
                 )
             _validate(node.right)
             return

         if isinstance(node, ast.UnaryOp):
             if type(node.op) not in ALLOWED_UNARY:
                 raise HTTPException(
                     status_code=400,
                     detail=f"Unsupported unary operator: {type(node.op).__name__}",
                 )
             _validate(node.operand)
             return

         raise HTTPException(status_code=400, detail="Unsupported expression")


     def _evaluate(node: ast.AST):
         if isinstance(node, ast.Expression):
             return _evaluate(node.body)

         if isinstance(node, ast.Constant):
             return node.value

         if isinstance(node, ast.BinOp):
             return ALLOWED_BINOPS[type(node.op)](
                 _evaluate(node.left),
                 _evaluate(node.right),
             )

         if isinstance(node, ast.UnaryOp):
             return ALLOWED_UNARY[type(node.op)](_evaluate(node.operand))

         raise HTTPException(status_code=400, detail="Unsupported expression")


     @app.get("/")
     def index():
         return FileResponse(INDEX_PATH)


     @app.post("/api/calculate")
     def calculate(payload: CalculateRequest):
         expression = payload.expression.strip()
         if not expression:
             raise HTTPException(status_code=400, detail="Expression is required")

         try:
             tree = ast.parse(expression, mode="eval")
             _validate(tree)
             result = _evaluate(tree)
         except HTTPException:
             raise
         except Exception:
             raise HTTPException(status_code=400, detail="Invalid expression")

         return {"result": result}
     ```

