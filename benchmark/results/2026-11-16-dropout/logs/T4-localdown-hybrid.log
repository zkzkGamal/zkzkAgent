   - Content:
   ```python
   import ast
   import math
   import operator
   import os

   from fastapi import FastAPI, HTTPException
   from fastapi.responses import FileResponse
   from fastapi.staticfiles import StaticFiles

   BASE_DIR = os.path.dirname(os.path.abspath(__file__))
   STATIC_DIR = os.path.join(BASE_DIR, "static")

   app = FastAPI(title="Calculator Web App")

   BIN_OPS = {
       ast.Add: operator.add,
       ast.Sub: operator.sub,
       ast.Mult: operator.mul,
       ast.Div: operator.truediv,
       ast.FloorDiv: operator.floordiv,
       ast.Mod: operator.mod,
       ast.Pow: operator.pow,
   }

   UNARY_OPS = {
       ast.USub: operator.neg,
       ast.UAdd: operator.pos,
   }


   def _is_finite_number(value):
       if isinstance(value, bool) or not isinstance(value, (int, float)):
           return False
       if isinstance(value, float) and not math.isfinite(value):
           return False
       return True


   def _eval(node):
       if isinstance(node, ast.Constant):
           if not _is_finite_number(node.value):
               raise ValueError("Only finite numeric values are supported")
           return node.value

       if isinstance(node, ast.BinOp):
           left = _eval(node.left)
           right = _eval(node.right)
           op = BIN_OPS.get(node.op)
           if op is None:
               raise ValueError("Unsupported operator")
           try:
               value = op(left, right)
           except ZeroDivisionError:
               raise ValueError("Division by zero is not allowed")
           if not _is_finite_number(value):
               raise ValueError("Result must be a finite number")
           return value

       if isinstance(node, ast.UnaryOp):
           operand = _eval(node.operand)
           op = UNARY_OPS.get(node.op)
           if op is None:
               raise ValueError("Unsupported unary operator")
           value = op(operand)
           if not _is_finite_number(value):
               raise ValueError("Result must be a finite number")
           return value

       raise ValueError("Unsupported expression")


   def evaluate_expression(expression):
       try:
           tree = ast.parse(expression, mode="eval")
           return _eval(tree.body)
       except Exception as exc:
           raise ValueError(f"Invalid expression: {exc}")


   @app.get("/")
   def index():
       return FileResponse(os.path.join(STATIC_DIR, "index.html"))


   @app.post("/api/calculate")
   def calculate(payload: dict):
       expression = payload.get("expression")
       if not isinstance(expression, str) or not expression.strip():
           raise HTTPException(
               status_code=400,
               detail="expression is required and must be a string"
           )

       try:
           result = evaluate_expression(expression)
       except ValueError as exc:
           raise HTTPException(status_code=400, detail=str(exc))

       return {"result": result}


   app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")
   ```

