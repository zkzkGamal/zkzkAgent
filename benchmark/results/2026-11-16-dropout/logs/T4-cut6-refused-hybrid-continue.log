ed: {type(node.op).__name__}")\n    else:\n        raise ValueError("Invalid expression")\n\n\ndef parse_expression(expr: str) -> int | float:\n    """Parse a string into an expression AST and evaluate it."""\n    tree = ast.parse(expr, mode=\'eval\')\n    return _eval_node(tree.body)\n\n\ndef generate_examples():\n    """Generate some example calculations."""\n    examples = [\n        ("5 + 3", 8),\n        ("5 * 5", 25),\n        ("10 / 2", 5.0),\n        ("25 % 3", 1),\n        ("** 4", 127),\n        ("-5", -5),\n        ("5 - 3", 2),\n    ]\n    return examples\n\n\nif __name__ == "__main__":\n    app.add_middleware(\n        FastAPIMidwifery.CORSMiddleware,\n        add_headers_fn=lambda request: None\n    )\n    \n    # Health check endpoint\n    @app.get("/health")\n    def health_check():\n        return {"status": "ok"}\n    \n    # Serve static files (index.html)\n    @app.get("/")\n    def index(request: FastAPI.Request) -> FileResponse:\n        return FileResponse("/static/index.html")\n    \n    # Main endpoint\n    @app.post("/api/calculate")\n    def calculate(request: CalculateRequest) -> int | float:\n        try:\n            parsed = parse_expression(request.expression)\n            return parsed\n        except Exception as e:\n            raise HTTPException(status_code=400, detail=str(e))\n    \n    # Serve static files from the static directory\n    @app.get("/static/")\n    def index_file(request: FastAPI.Request) -> FileResponse:\n        return FileResponse("/static/index.html")\n    \n    # Example endpoints (for browser demo)\n    @app.get("/examples")\n    def get_examples():\n        return {\n            "examples": generate_examples()\n        }\n    \n    if __name__ == "__main__":\n        import uvicorn\n        uvicorn.run(app, host="0.0.0.0", port=8000)\n'}, 'id': '2a2b29d1-7ff3-469c-8453-8049d2adeb5e', 'type': 'tool_call'}]
                
