  <input id="display" type="text" placeholder="e.g. 2 + 2 * 10" autocomplete="off" />\n    <div id="result"></div>\n    <div class="buttons">\n      <button data-val="(">(</button>\n      <button data-val=")")">)</button>\n      <button data-val="/">/</button>\n      <button data-val="*">*</button>\n      <button data-val="7">7</button>\n      <button data-val="8">8</button>\n      <button data-val="9">9</button>\n      <button data-val="-">-</button>\n      <button data-val="4">4</button>\n      <button data-val="5">5</button>\n      <button data-val="6">6</button>\n      <button data-val="+">+</button>\n      <button data-val="1">1</button>\n      <button data-val="2">2</button>\n      <button data-val="3">3</button>\n      <button data-val="^" data-expr="**">^</button>\n      <button data-val="%" data-expr="**0.5" title="square root">&radic;</button>\n      <button data-val="0">0</button>\n      <button data-val=".">.</button>\n      <button data-val="C" class="clear">C</button>\n      <button class="equals" id="equals">=</button>\n    </div>\n  </div>\n  <script>\n    const display = document.getElementById("display");\n    const resultEl = document.getElementById("result");\n\n    function append(val) {\n      if (val === "C") {\n        display.value = "";\n        resultEl.textContent = "";\n        return;\n      }\n      display.value += val;\n    }\n\n    document.querySelectorAll("button[data-val]").forEach((btn) => {\n      btn.addEventListener("click", () => append(btn.dataset.expr || btn.dataset.val));\n    });\n\n    document.getElementById("equals").addEventListener("click", evaluate);\n    display.addEventListener("keydown", (e) => {\n      if (e.key === "Enter") evaluate();\n    });\n\n    async function evaluate() {\n      const expression = display.value.trim();\n      if (!expression) return;\n      try {\n        const res = await fetch("/api/calculate", {\n          method: "POST",\n          headers: { "Content-Type": "application/json" },\n 