    result = _eval_node(tree)\n    except ZeroDivisionError as exc:\n        raise HTTPException(status_code=400, detail="Division by zero") from exc\n    except ValueError as exc:\n        raise HTTPException(status_code=400, detail=str(exc)) from exc\n    return result\n\n\n@app.get("/")\nasync def index():\n    return FileResponse(STATIC_DIR / "index.html")\n\n\n@app.post("/api/calculate")\nasync def calculate_endpoint(request: CalcRequest):\n    result = calculate(request.expression.strip())\n    return {"result": result}\n\n\nif __name__ == "__main__":\n    import uvicorn\n\n    uvicorn.run(app, host="0.0.0.0", port=8000)\n'}, 'id': 'chatcmpl-tool-b00eacd83ac62153', 'type': 'tool_call'}]
                
