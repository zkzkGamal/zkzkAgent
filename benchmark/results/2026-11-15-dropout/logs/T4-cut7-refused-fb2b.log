Div = document.getElementById("result");\n\n    async function calculate() {\n      const expression = expressionInput.value.trim();\n      if (!expression) {\n        resultDiv.textContent = "Enter an expression";\n        resultDiv.className = "result error";\n        return;\n      }\n      try {\n        const response = await fetch("/api/calculate", {\n          method: "POST",\n          headers: { "Content-Type": "application/json" },\n          body: JSON.stringify({ expression }),\n        });\n        const data = await response.json();\n        if (!response.ok) {\n          resultDiv.textContent = data.detail || "Error";\n          resultDiv.className = "result error";\n        } else {\n          resultDiv.textContent = "=" + data.result;\n          resultDiv.className = "result";\n        }\n      } catch (err) {\n        resultDiv.textContent = "Request failed";\n        resultDiv.className = "result error";\n      }\n    }\n\n    calculateBtn.addEventListener("click", calculate);\n    expressionInput.addEventListener("keydown", (e) => {\n      if (e.key === "Enter") calculate();\n    });\n  </script>\n</body>\n</html>\n'}, 'id': 'chatcmpl-tool-81aedad4d47b93d4', 'type': 'tool_call'}]
                
