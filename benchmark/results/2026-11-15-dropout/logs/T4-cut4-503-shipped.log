   - `content` including a simple calculator UI that sends `POST /api/calculate` with JSON and displays the returned `result`.
   Example content:
   ```html
   <!doctype html>
   <html lang="en">
   <head>
     <meta charset="utf-8" />
     <meta name="viewport" content="width=device-width, initial-scale=1" />
     <title>Calculator</title>
   </head>
   <body>
     <h1>Calculator</h1>
     <form id="calculator-form">
       <input id="expression" name="expression" type="text" placeholder="2 + 2" required />
       <button type="submit">Calculate</button>
     </form>
     <pre id="result">Result: </pre>

     <script>
       const form = document.getElementById("calculator-form");
       const resultEl = document.getElementById("result");

       form.addEventListener("submit", async (event) => {
         event.preventDefault();

         const expression = document.getElementById("expression").value.trim();
         resultEl.textContent = "Calculating...";

         try {
           const response = await fetch("/api/calculate", {
             method: "POST",
             headers: {
               "Content-Type": "application/json"
             },
             body: JSON.stringify({ expression })
           });

           const data = await response.json();

           if (response.ok) {
             resultEl.textContent = `Result: ${data.result}`;
           } else {
             resultEl.textContent = `Error: ${data.detail || "Unknown error"}`;
           }
         } catch (error) {
           resultEl.textContent = `Request failed: ${error}`;
         }
       });
     </script>
   </body>
   </html>
   ```
