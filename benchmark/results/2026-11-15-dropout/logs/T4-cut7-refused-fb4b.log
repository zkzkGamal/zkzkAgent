   ```python
   from pathlib import Path
   import ast
   import operator
   from typing import Union

   from fastapi import FastAPI, HTTPException
   from fastapi.staticfiles import StaticFiles
   from pydantic import BaseModel

   Number = Union[int, float]

   app = FastAPI(title="Calculator Web App")


   class CalculateRequest(BaseModel):
       expression: str


   ALLOWED_BINARY_OPS = {
       ast.Add: operator.add,
       ast.Sub: operator.sub,
       ast.Mult: operator.mul,
       ast.Div: operator.truediv,
       ast.FloorDiv: operator.floordiv,
       ast.Mod: operator.mod,
       ast.Pow: operator.pow,
   }

   ALLOWED_UNARY_OPS = {
       ast.UAdd: operator.pos,
       ast.USub: operator.neg,
   }


   def _evaluate(node: ast.AST) -> Number:
       if isinstance(node, ast.Expression):
           return _evaluate(node.body)

       if isinstance(node, ast.Constant):
           if isinstance(node.value, bool) or not isinstance(node.value, (int, float)):
               raise HTTPException(
                   status_code=400,
                   detail="Only numeric constants are allowed."
               )
           return node.value

       if isinstance(node, ast.BinOp):
           op_type = type(node.op)
           if op_type not in ALLOWED_BINARY_OPS:
               raise HTTPException(status_code=400, detail="Unsupported operator.")

           left = _evaluate(node.left)
           right = _evaluate(node.right)

           if op_type in (ast.Div, ast.FloorDiv) and right == 0:
               raise HTTPException(status_code=400, detail="Division by zero is not allowed.")

           if op_type is ast.Pow and isinstance(right, int) and abs(right) > 1000:
               raise HTTPException(status_code=400, detail="Exponent is too large.")

           return ALLOWED_BINARY_OPS[op_type](left, right)

       if isinstance(node, ast.UnaryOp):
           op_type = type(node.op)
           if op_type not in ALLOWED_UNARY_OPS:
               raise HTTPException(status_code=400, detail="Unsupported operator.")
           return ALLOWED_UNARY_OPS[op_type](_evaluate(node.operand))

       raise HTTPException(status_code=400, detail="Unsupported expression.")


   @app.post("/api/calculate")
   def calculate(request: CalculateRequest) -> dict:
       try:
           tree = ast.parse(request.expression, mode="eval")
       except SyntaxError:
           raise HTTPException(status_code=400, detail="Invalid expression syntax.")

       try:
           result = _evaluate(tree)
       except HTTPException:
           raise
       except Exception:
           raise HTTPException(status_code=400, detail="Could not evaluate expression.")

       if isinstance(result, float) and result.is_integer():
           result = int(result)

       return {"result": result}


   static_dir = Path(__file__).resolve().parent / "static"

   # Defined after /api/calculate so the API route is not shadowed by the static mount.
   app.mount("/", StaticFiles(directory=str(static_dir), html=True), name="static")
   ```

