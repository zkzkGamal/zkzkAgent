     - `content`:
     ```python
     from __future__ import annotations

     import ast
     import operator
     from pathlib import Path

     from fastapi import FastAPI, HTTPException
     from fastapi.responses import FileResponse
     from fastapi.staticfiles import StaticFiles
     from pydantic import BaseModel

     BASE_DIR = Path(__file__).resolve().parent
     STATIC_DIR = BASE_DIR / "static"

     app = FastAPI(title="calc_app")

     if STATIC_DIR.exists():
         app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")


     class CalculateRequest(BaseModel):
         expression: str


     ALLOWED_BINOPS = {
         ast.Add: operator.add,
         ast.Sub: operator.sub,
         ast.Mult: operator.mul,
         ast.Div: operator.truediv,
         ast.FloorDiv: operator.floordiv,
         ast.Mod: operator.mod,
         ast.Pow: operator.pow,
     }

     ALLOWED_UNARYOPS = {
         ast.UAdd: operator.pos,
         ast.USub: operator.neg,
     }


     def is_number(value):
         return isinstance(value, (int, float)) and not isinstance(value, bool)


     def safe_eval(node):
         if isinstance(node, ast.Expression):
             return safe_eval(node.body)

         if isinstance(node, ast.Constant):
             if is_number(node.value):
                 return node.value
             raise HTTPException(status_code=400, detail="Unsupported constant in expression")

         if isinstance(node, ast.BinOp):
             op_type = type(node.op)
             if op_type not in ALLOWED_BINOPS:
                 raise HTTPException(status_code=400, detail="Unsupported operator in expression")
             return ALLOWED_BINOPS[op_type](safe_eval(node.left), safe_eval(node.right))

         if isinstance(node, ast.UnaryOp):
             op_type = type(node.op)
             if op_type not in ALLOWED_UNARYOPS:
                 raise HTTPException(status_code=400, detail="Unsupported unary operator in expression")
             return ALLOWED_UNARYOPS[op_type](safe_eval(node.operand))

         raise HTTPException(status_code=400, detail="Unsupported expression syntax")


     @app.get("/")
     def index():
         index_file = STATIC_DIR / "index.html"
         if not index_file.exists():
             raise HTTPException(status_code=500, detail="static/index.html is missing")
         return FileResponse(index_file)


     @app.post("/api/calculate")
     def calculate(payload: CalculateRequest):
         expression = payload.expression.strip()
         if not expression:
             raise HTTPException(status_code=400, detail="expression must not be empty")

         try:
             tree = ast.parse(expression, mode="eval")
         except (SyntaxError, ValueError):
             raise HTTPException(status_code=400, detail="Invalid expression")

         try:
             result = safe_eval(tree)
         except HTTPException:
             raise
         except ZeroDivisionError:
             raise HTTPException(status_code=400, detail="Division by zero")
         except Exception as exc:
             raise HTTPException(status_code=400, detail=f"Cannot evaluate expression: {exc}")

         if not is_number(result):
             raise HTTPException(status_code=400, detail="Expression did not evaluate to a number")

         return {"result": result}
     ```

