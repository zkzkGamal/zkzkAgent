   - `content`:
   ```python
   from fastapi import FastAPI, HTTPException
   from fastapi.responses import FileResponse
   from pydantic import BaseModel
   import ast
   import operator
   import os

   app = FastAPI(title="calc_app")

   BASE_DIR = os.path.dirname(os.path.abspath(__file__))
   STATIC_DIR = os.path.join(BASE_DIR, "static")
   INDEX_HTML = os.path.join(STATIC_DIR, "index.html")


   class CalculateRequest(BaseModel):
       expression: str


   BIN_OPS = {
       ast.Add: operator.add,
       ast.Sub: operator.sub,
       ast.Mult: operator.mul,
       ast.Div: operator.truediv,
       ast.Pow: operator.pow,
   }

   UNARY_OPS = {
       ast.UAdd: operator.pos,
       ast.USub: operator.neg,
   }


   def evaluate_node(node: ast.AST):
       if isinstance(node, ast.Expression):
           return evaluate_node(node.body)

       if isinstance(node, ast.Constant):
           if isinstance(node.value, (int, float)) and not isinstance(node.value, bool):
               return node.value
           raise HTTPException(status_code=400, detail="Unsupported expression")

       if isinstance(node, ast.BinOp):
           if type(node.op) in BIN_OPS:
               return BIN_OPS[type(node.op)](
                   evaluate_node(node.left),
                   evaluate_node(node.right),
               )
           raise HTTPException(status_code=400, detail="Unsupported operator")

       if isinstance(node, ast.UnaryOp):
           if type(node.op) in UNARY_OPS:
               return UNARY_OPS[type(node.op)](evaluate_node(node.operand))
           raise HTTPException(status_code=400, detail="Unsupported unary operator")

       raise HTTPException(status_code=400, detail="Unsupported expression")


   @app.get("/")
   async def serve_index():
       return FileResponse(INDEX_HTML)


   @app.get("/index.html")
   async def serve_index_named():
       return FileResponse(INDEX_HTML)


   @app.post("/api/calculate")
   async def calculate(payload: CalculateRequest):
       expression = payload.expression.strip()

       try:
           tree = ast.parse(expression, mode="eval")
           result = evaluate_node(tree)

           if isinstance(result, float) and result.is_integer():
               result = int(result)

       except HTTPException:
           raise
       except ZeroDivisionError:
           raise HTTPException(status_code=400, detail="Division by zero")
       except Exception:
           raise HTTPException(status_code=400, detail="Invalid expression")

       return {"result": result}
   ```

