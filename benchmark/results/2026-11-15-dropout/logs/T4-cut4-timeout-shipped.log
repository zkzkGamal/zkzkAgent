   ```python
   import ast
   import operator
   from pathlib import Path
   from typing import Any

   from fastapi import FastAPI, HTTPException
   from fastapi.responses import FileResponse
   from fastapi.staticfiles import StaticFiles
   from pydantic import BaseModel

   BASE_DIR = Path(__file__).resolve().parent
   STATIC_DIR = BASE_DIR / "static"

   app = FastAPI(title="Calculator")


   class CalculationRequest(BaseModel):
       expression: str


   _ALLOWED_BINOPS = {
       ast.Add: operator.add,
       ast.Sub: operator.sub,
       ast.Mult: operator.mul,
       ast.Div: operator.truediv,
       ast.FloorDiv: operator.floordiv,
       ast.Mod: operator.mod,
       ast.Pow: operator.pow,
   }

   _ALLOWED_UNARYOPS = {
       ast.UAdd: operator.pos,
       ast.USub: operator.neg,
   }


   def _eval_node(node: ast.AST) -> Any:
       if isinstance(node, ast.Expression):
           return _eval_node(node.body)

       if isinstance(node, ast.Constant) and isinstance(node.value, (int, float)):
           return node.value

       if isinstance(node, ast.BinOp) and type(node.op) in _ALLOWED_BINOPS:
           left = _eval_node(node.left)
           right = _eval_node(node.right)
           return _ALLOWED_BINOPS[type(node.op)](left, right)

       if isinstance(node, ast.UnaryOp) and type(node.op) in _ALLOWED_UNARYOPS:
           return _ALLOWED_UNARYOPS[type(node.op)](_eval_node(node.operand))

       raise ValueError("Unsupported expression")


   def safe_calculate(expression: str) -> Any:
       tree = ast.parse(expression, mode="eval")
       return _eval_node(tree)


   @app.get("/")
   def index() -> FileResponse:
       return FileResponse(STATIC_DIR / "index.html")


   @app.post("/api/calculate")
   def calculate(payload: CalculationRequest):
       try:
           result = safe_calculate(payload.expression)
       except Exception as exc:
           raise HTTPException(status_code=400, detail=f"Invalid expression: {exc}")

       return {"result": result}


   if STATIC_DIR.is_dir():
       app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")
   ```
4. **Write frontend**: Use `write_file` with `working_directory=/home/aloha-zkaria/zkzk-bench/dropout/T4-cut4-timeout-shipped/rep1/calc_app/static`, `file_path=/home/aloha-zkaria/zkzk-bench/dropout/T4-cut4-timeout-shipped/rep1/calc_app/static/index.html`, and content:
