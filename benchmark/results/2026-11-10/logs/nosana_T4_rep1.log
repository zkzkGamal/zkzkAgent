<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Calc App</title>
  <style>
    :root {
      color-scheme: dark;
    }

    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #0f172a;
      font-family: system-ui, -apple-system, sans-serif;
    }

    .calculator {
      width: min(360px, calc(100vw - 32px));
      background: #1e293b;
      border-radius: 20px;
      padding: 20px;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.35);
    }

    .display {
      width: 100%;
      box-sizing: border-box;
      height: 56px;
      margin-bottom: 16px;
      padding: 0 14px;
      font-size: 1.4rem;
      text-align: right;
      color: #f8fafc;
      background: #0f172a;
      border: 1px solid #334155;
      border-radius: 12px;
    }

    .buttons {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 10px;
    }

    button {
      height: 54px;
      border: 0;
      border-radius: 12px;
      font-size: 1.1rem;
      color: white;
      background: #334155;
      cursor: pointer;
      transition: background 0.15s ease;
    }

    button:hover {
      background: #475569;
    }

    .operator {
      background: #475569;
    }

    .operator:hover {
      background: #64748b;
    }

    .equals {
      background: #2563eb;
    }

    .equals:hover {
      background: #3b82f6;
    }

    .clear {
      background: #dc2626;
    }

    .clear:hover {
      background: #ef4444;
    }
  </style>
</head>
<body>
  <main class="calculator">
    <input
      id="expression"
      class="display"
      type="text"
      placeholder="0"
      autocomplete="off"
      aria-label="Expression"
    />

    <div class="buttons">
      <button type="button" class="clear" data-action="clear">C</button>
      <button type="button" data-value="(">(</button>
      <button type="button" data-value=")">)</button>
      <button type="button" class="operator" data-value="/">/</button>

      <button type="button" data-value="7">7</button>
      <button type="button" data-value="8">8</button>
      <button type="button" data-value="9">9</button>
      <button type="button" class="operator" data-value="*">*</button>

      <button type="button" data-value="4">4</button>
      <button type="button" data-value="5">5</button>
      <button type="button" data-value="6">6</button>
      <button type="button" class="operator" data-value="-">-</button>

      <button type="button" data-value="1">1</button>
      <button type="button" data-value="2">2</button>
      <button type="button" data-value="3">3</button>
      <button type="button" class="operator" data-value="+">+</button>

      <button type="button" data-value="0">0</button>
      <button type="button" data-value=".">.</button>
      <button type="button" class="equals" data-action="equals">=</button>
      <button type="button" data-action="delete">⌫</button>
    </div>
  </main>

  <script>
    const input = document.getElementById('expression');

    function append(value) {
      input.value += value;
      input.focus();
    }

    function clearExpression() {
      input.value = '';
      input.focus();
    }

    function deleteLast() {
      input.value = input.value.slice(0, -1);
      input.focus();
    }

    async function calculate() {
      const expression = input.value.trim();
      if (!expression) return;

      try {
        const response = await fetch('/api/calculate', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ expression }),
        });

        const data = await response.json();

        if (!response.ok) {
          input.value = data.detail || 'Error';
          return;
        }

        input.value = String(data.result);
      } catch (error) {
        input.value = 'Network error';
      }
    }

    document.querySelectorAll('button').forEach((button) => {
      button.addEventListener('click', () => {
        const value = button.dataset.value;
        const action = button.dataset.action;

        if (value) append(value);
        if (action === 'clear') clearExpression();
        if (action === 'delete') deleteLast();
        if (action === 'equals') calculate();
      });
    });

    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        calculate();
      }
    });
  </script>
</body>
</html>
