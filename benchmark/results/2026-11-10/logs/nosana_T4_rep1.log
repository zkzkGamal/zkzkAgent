from __future__ import annotations

import ast
import math
import operator
from pathlib import Path

from fastapi import FastAPI, HTTPException
from fastapi.responses import FileResponse
from fastapi.staticfiles import StaticFiles
from pydantic import BaseModel

BASE_DIR = Path(__file__).resolve().parent
STATIC_DIR = BASE_DIR / "static"

app = FastAPI(title="Calc App")


class CalculateRequest(BaseModel):
    expression: str


_BIN_OPS = {
    ast.Add: operator.add,
    ast.Sub: operator.sub,
    ast.Mult: operator.mul,
    ast.Div: operator.truediv,
    ast.FloorDiv: operator.floordiv,
    ast.Mod: operator.mod,
    ast.Pow: operator.pow,
}

_UNARY_OPS = {
    ast.UAdd: operator.pos,
    ast.USub: operator.neg,
}


def _eval_node(node: ast.AST):
    if isinstance(node, ast.Expression):
        return _eval_node(node.body)

    if isinstance(node, ast.BinOp):
        op_type = type(node.op)
        if op_type not in _BIN_OPS:
            raise HTTPException(status_code=400, detail="Unsupported operator")

        left = _eval_node(node.left)
        right = _eval_node(node.right)

        if op_type is ast.Pow and isinstance(right, (int, float)) and not isinstance(right, bool):
            if abs(right) > 1000:
                raise HTTPException(status_code=400, detail="Exponent too large")

        return _BIN_OPS[op_type](left, right)

    if isinstance(node, ast.UnaryOp):
        op_type = type(node.op)
        if op_type not in _UNARY_OPS:
            raise HTTPException(status_code=400, detail="Unsupported operator")

        return _UNARY_OPS[op_type](_eval_node(node.operand))

    if isinstance(node, ast.Constant):
        if isinstance(node.value, (int, float)) and not isinstance(node.value, bool):
            return node.value

    raise HTTPException(status_code=400, detail="Invalid expression")


def _normalize_result(value):
    if isinstance(value, float):
        value = round(value, 10)
        if value.is_integer():
            return int(value)
    return value


@app.post("/api/calculate")
async def calculate(payload: CalculateRequest):
    expression = payload.expression.strip().replace("^", "**")
    if not expression:
        raise HTTPException(status_code=400, detail="Expression is required")

    try:
        tree = ast.parse(expression, mode="eval")
    except SyntaxError:
        raise HTTPException(status_code=400, detail="Invalid expression")

    try:
        result = _eval_node(tree)
    except ZeroDivisionError:
        raise HTTPException(status_code=400, detail="Division by zero")

    if isinstance(result, float) and not math.isfinite(result):
        raise HTTPException(status_code=400, detail="Result is not finite")

    return {"result": _normalize_result(result)}


@app.get("/")
async def index():
    return FileResponse(STATIC_DIR / "index.html")


if STATIC_DIR.exists():
    app.mount("/static", StaticFiles(directory=STATIC_DIR), name="static")
```

