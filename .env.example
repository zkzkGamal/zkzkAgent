GPG_PASSWORD=""
SSH_FRONTEND=""
FRONTEND_PORT=""
DEPLOYFILE_PATH=""
OLLAMA_MODEL="qwen3:1.7b-q4_K_M "
OLLAMA_BASE_URL="http://127.0.0.1:11434"
# "true" only for thinking-only models such as qwen3:4b, so their reasoning stays out of replies
OLLAMA_REASONING="false"
# Context window in tokens (prompt + reply); leave empty for Ollama's default of 4096
OLLAMA_NUM_CTX=""
# Model backend: OLLAMA (local, default) or NOSANA (decentralized GPU)
MODEL_TYPE="OLLAMA"
# Nosana API key, starts with nos_
NOSANA_API_KEY=""
NOSANA_BASE_URL="https://inference.nosana.com/v1"
# Leave empty to use the first model Nosana is serving right now
NOSANA_MODEL=""
